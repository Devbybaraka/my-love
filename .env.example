# Neon Postgres (Project → Connection Details → Connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Express API port (the Vite dev server proxies /api here)
PORT=4000

# The word you type on /upload so only you can add movies
UPLOAD_PASSCODE=our-word

# Cloudinary (cloudinary.com/console → Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Direct browser → Cloudinary upload (for films over ~4.5 MB on Vercel).
# Create an UNSIGNED upload preset in the Cloudinary dashboard
# (Settings → Upload → Upload presets → Add → Signing Mode: Unsigned),
# then expose its name + your cloud name to the frontend build:
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: where uploaded films are stored (defaults to ./uploads)
# UPLOADS_DIR=/absolute/path/to/uploads
