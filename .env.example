# Neon Postgres (Project → Connection Details → Connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Express API port (the Vite dev server proxies /api here)
PORT=4000

# The word you type on /upload so only you can add movies
UPLOAD_PASSCODE=our-word

# The word she types to open the WHOLE site (films + letter). Make it short
# and easy to remember — this is NOT the upload word below. Leave empty to
# reuse UPLOAD_PASSCODE (only if you want one word for both).
SITE_PASSCODE=

# Optional: email her when a new film / episode goes up (resend.com).
# Leave empty and nothing is sent — uploads behave exactly the same.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM="Our Movie Corner <onboarding@resend.dev>"
# PUBLIC_SITE_URL=https://my-love-plum-five.vercel.app

# Cloudinary — POSTERS ONLY now (videos live on Bunny Stream).
# cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Direct browser → Cloudinary upload for posters (no size limit on Vercel).
# Create an UNSIGNED upload preset in the Cloudinary dashboard
# (Settings → Upload → Upload presets → Add → Signing Mode: Unsigned),
# then expose its name + your cloud name to the frontend build:
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Bunny Stream — VIDEOS (700 MB+ fine, adaptive quality).
# dash.bunny.net → Stream → your library. Library ID is in the library URL
# (/stream/libraries/<id>/…); the API key is under library → API.
# Videos are uploaded browser → Bunny over TUS; these keys stay server-side.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Optional: where uploaded films are stored (defaults to ./uploads)
# UPLOADS_DIR=/absolute/path/to/uploads
